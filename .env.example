# =============================================================================
# CONFIGURAÇÃO DO AMBIENTE - Copie este arquivo para .env e preencha os valores
# =============================================================================

# --- Banco de Dados MySQL ---
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=seu_usuario_mysql
MYSQL_PASSWORD=sua_senha_mysql
MYSQL_DATABASE=nome_do_banco

# --- Sessão ---
# IMPORTANTE: Use um valor aleatório forte (mínimo 32 caracteres)
# Gere com: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
SESSION_SECRET=TROCAR_POR_VALOR_ALEATORIO_FORTE

# --- Ambiente ---
# Valores: development | production
NODE_ENV=development

# --- Evolution API (WhatsApp) - Opcional ---
EVOLUTION_API_URL=https://sua-evolution-api.exemplo.com
EVOLUTION_API_KEY=sua_evolution_api_key

# --- OpenAI - Opcional (para agente IA) ---
OPENAI_API_KEY=sk-sua-chave-openai

# --- Asaas (Pagamentos) - Opcional ---
ASAAS_API_KEY=sua_asaas_api_key
ASAAS_ENVIRONMENT=sandbox

# --- Depuração (apenas desenvolvimento) ---
DEBUG_SQL_QUERIES=false
DEBUG_N8N_WEBHOOK=false
DEBUG_WHATSAPP_WEBHOOK=false

# --- VPS / Deploy Remoto (apenas desenvolvimento) ---
# VPS_HOST=seu_servidor.exemplo.com
# VPS_MYSQL_USER=usuario_remoto
# VPS_MYSQL_PASSWORD=senha_remota
# VPS_MYSQL_DATABASE=banco_remoto
# VPS_SSH_USER=usuario_ssh
# VPS_PROJECT_PATH=/caminho/do/projeto

# --- URL Base da Aplicação ---
# BASE_URL=https://seu-dominio.com.br
